# SIG Maps V2 - Environment Configuration
# Copy this file to .env and update values

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=sigmaps_user
POSTGRES_PASSWORD=your_secure_password_change_me
POSTGRES_DB=sigmaps_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_change_me

# ============================================
# JWT & Security
# ============================================
# Generate strong secret: openssl rand -base64 64
JWT_SECRET=your_very_secure_jwt_secret_min_64_chars_change_me_immediately
NODE_ENV=production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# API Configuration
# ============================================
API_PORT=3005
API_HOST=0.0.0.0
FRONTEND_URL=https://sig-frontend.tail7d68dd.ts.net

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://sig-backend.tail7d68dd.ts.net

# ============================================
# MinIO Configuration
# ============================================
MINIO_USER=sigmaps_minio
MINIO_PASSWORD=your_minio_secure_password_change_me
MINIO_BUCKET=sigmaps

# ============================================
# Optional: Monitoring
# ============================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_change_me
